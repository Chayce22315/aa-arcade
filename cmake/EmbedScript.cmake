# Script mode: cmake -DOUTPUT=... -DBASE_DIR=... -DFILES=a|b|c -P EmbedScript.cmake
string(REPLACE "|" ";" file_list "${FILES}")

set(body "// Generated by cmake/EmbedScript.cmake. Do not edit.\n#include \"assets/EmbeddedAssets.hpp\"\n\nnamespace spindle::assets::detail {\nnamespace {\n")
set(table "")
set(index 0)
foreach(f IN LISTS file_list)
  file(READ "${BASE_DIR}/${f}" hex HEX)
  file(SIZE "${BASE_DIR}/${f}" size)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],))" "\\1\n" bytes "${bytes}")
  # A trailing NUL keeps zero-length files legal and text files C-string friendly; it is not counted in size.
  string(APPEND body "const unsigned char kData${index}[] = {\n${bytes}0x00};\n")
  string(APPEND table "    {\"${f}\", kData${index}, ${size}u},\n")
  math(EXPR index "${index} + 1")
endforeach()
string(APPEND body "} // namespace\n\nconst EmbeddedFile kEmbeddedFiles[] = {\n${table}};\nconst std::size_t kEmbeddedFileCount = ${index};\n\n} // namespace spindle::assets::detail\n")

set(write_output TRUE)
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" previous)
  if(previous STREQUAL body)
    set(write_output FALSE)
  endif()
endif()
if(write_output)
  file(WRITE "${OUTPUT}" "${body}")
endif()
